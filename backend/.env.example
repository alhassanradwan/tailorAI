# AdaptiveAI Environment Configuration
# Copy this file to .env and fill in your values

# Flask Settings
FLASK_SECRET_KEY=your-super-secret-key-change-this
FLASK_ENV=development

# MongoDB Settings (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=adaptiveai

# OpenAI API Key (Required for AI agents)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alternative: Groq API (Free tier available)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=
USE_LANGCHAIN=true
# HuggingFace API Key (for RAG embedding model)
HUGGINGFACEHUB_API_TOKEN=
HF_HUB_DISABLE_XET=1

# RAG Integration
USE_RAG=true
NEO4J_URI=neo4j+ssc://your-neo4j-uri
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password